{
    "name": "appsolutely/sdk-laravel",
    "description": "Laravel bridge for the Appsolutely PHP SDK: configuration, a container binding and facade, a Socialite provider for OpenID Connect sign-in, and a verified webhook route that dispatches Laravel events.",
    "type": "library",
    "license": "MIT",
    "keywords": ["appsolutely", "laravel", "socialite", "openid-connect", "standard-webhooks", "sdk"],
    "homepage": "https://github.com/appsolutely-io/sdk-laravel",
    "support": {
        "issues": "https://github.com/appsolutely-io/sdk-laravel/issues",
        "source": "https://github.com/appsolutely-io/sdk-laravel",
        "security": "https://github.com/appsolutely-io/sdk-laravel/security/policy"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/appsolutely-io/sdk-php" }
    ],
    "require": {
        "php": "^8.3",
        "appsolutely/sdk-php": "^0.1@dev",
        "guzzlehttp/psr7": "^2.13",
        "illuminate/cache": "^12.69 || ^13.30",
        "illuminate/console": "^12.69 || ^13.30",
        "illuminate/contracts": "^12.69 || ^13.30",
        "illuminate/events": "^12.69 || ^13.30",
        "illuminate/http": "^12.69 || ^13.30",
        "illuminate/routing": "^12.69 || ^13.30",
        "illuminate/support": "^12.69 || ^13.30",
        "laravel/socialite": "^5.24.3",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0.3",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^7.2 || ^8.0",
        "symfony/http-foundation": "^7.2 || ^8.0"
    },
    "require-dev": {
        "firebase/php-jwt": "^7.0.5",
        "friendsofphp/php-cs-fixer": "^3.95",
        "illuminate/testing": "^12.69 || ^13.30",
        "larastan/larastan": "^3.13",
        "orchestra/testbench": "^10.2 || ^11.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "conflict": {
        "firebase/php-jwt": "<7.0.5"
    },
    "suggest": {
        "illuminate/testing": "For the InteractsWithAppsolutelyWebhooks trait in feature tests; laravel/framework includes it."
    },
    "autoload": {
        "psr-4": {
            "Appsolutely\\Sdk\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Appsolutely\\Sdk\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        },
        "laravel": {
            "providers": [
                "Appsolutely\\Sdk\\Laravel\\AppsolutelyServiceProvider"
            ],
            "aliases": {
                "Appsolutely": "Appsolutely\\Sdk\\Laravel\\Facades\\Appsolutely"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "analyse": "Run PHPStan with Larastan at level max with strict rules.",
        "cs": "Check coding style (PER-CS 3.0) without changing files.",
        "cs:fix": "Fix coding style (PER-CS 3.0) in place.",
        "check": "Validate composer.json, then run cs, analyse and test."
    },
    "minimum-stability": "stable"
}
